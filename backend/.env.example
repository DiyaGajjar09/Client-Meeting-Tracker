# Application Settings
APP_ENV=development
APP_NAME="Client Meeting-to-Action Tracker"
APP_VERSION=0.1.0
DEBUG=True

# Authentication & Access Control (v1 Shared Password / SSO Gate)
AUTH_ENABLED=True
APP_SHARED_PASSWORD=change_this_shared_password_in_production
API_SECRET_KEY=change_this_jwt_hmac_signing_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting Controls (Requests per minute)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN=10
RATE_LIMIT_MEETINGS=30
RATE_LIMIT_EXTRACT=15
RATE_LIMIT_EXPORT=30

# MySQL 8.0+ Database Configuration
# Safe URL will be constructed using SQLAlchemy URL.create(drivername="mysql+pymysql", ...)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meeting_action_tracker
DB_USER=meeting_app
DB_PASSWORD=change_this_password

# Dedicated Test Database (Used for automated tests)
TEST_DB_NAME=meeting_action_tracker_test

# CORS Allowed Origins (Local React Frontend)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175"]

# Ingestion & Validation Limits
MAX_PASTED_TEXT_CHARS=150000
MAX_UPLOAD_BYTES=10485760
RETENTION_DAYS=90

# Google Gemini AI Extraction Engine
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
LLM_PROVIDER="gemini"
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
CHUNK_TARGET_TOKENS=3500
CHUNK_OVERLAP_TOKENS=250
QUOTE_MATCH_MIN_RATIO=0.85
PROMPT_VERSION="v2.1"
NEXT_WEEKDAY_CONVENTION="following_week"


